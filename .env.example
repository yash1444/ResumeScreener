# LLM provider (optional - the pipeline falls back to rule-based scoring without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GitHub enrichment (optional - raises the API limit from 60 to 5000 requests/hour)
GITHUB_TOKEN=

# Tuning (all optional)
LLM_CONCURRENCY=5
GITHUB_CONCURRENCY=5

# Optional: alternative keyword vocabulary (default: src/resume_screener/keywords.yaml)
# KEYWORDS_FILE=
